#!/bin/bash

# this script needs to be run as user
MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
source $MYDIR/auto-video-ingest.cfg

# All messages of one run share a single desktop notification, which gets
# updated in place (notify-send --replace-id) instead of spamming new ones.
NOTIFY_ID=""

# usage: log "message" [level]   (level: debug|normal|critical, default normal)
#   debug:    low urgency, transient (not kept in the notification list), vanishes after 3s
#   normal:   regular notification
#   critical: stays on screen until dismissed
function log {
	DATE=$(date "+%Y-%m-%d %H:%M:%S")
	echo "$DATE $1" >>$LOGFILE

	local ARGS=(--app-name="auto-video-ingest" --print-id)
	case "${2:-normal}" in
		debug)    ARGS+=(--urgency=low --transient --expire-time=3000) ;;
		critical) ARGS+=(--urgency=critical) ;;
		*)        ARGS+=(--urgency=normal) ;;
	esac
	[[ -n "$NOTIFY_ID" ]] && ARGS+=(--replace-id="$NOTIFY_ID")
	local NEW_ID
	NEW_ID=$(notify-send "${ARGS[@]}" "auto-video-ingest" "$1" 2>/dev/null)
	[[ "$NEW_ID" =~ ^[0-9]+$ ]] && NOTIFY_ID=$NEW_ID
}

log "Auto-video-ingest called for device $DEVICE" debug

# this is only required for the stupid usb readers which are slow. and those are
# only required because the intel nuc can not read one sandisk... thanks obama
START=$(date +%s)
for try in {1..50} ; do
	MOUNTPOINT=$(findmnt --source "$DEVICE" --output TARGET --noheadings)
	[[ -n "$MOUNTPOINT" ]] && break
	sleep .2
done
DURATION=$(( $(date +%s) - START ))

if [ -z "$MOUNTPOINT" ];
then
	log "No mount point for SD card $DEVICE found after 10 seconds. Exiting" debug
	exit 0
else
	log "Mount for SD card $DEVICE found on $MOUNTPOINT after $DURATION seconds" debug
fi

# Checking if SD card is configured for auto-video-ingest
CARDCFG="$MOUNTPOINT/auto-video-ingest.cfg"
if [ ! -f "$CARDCFG" ];
then
	log "Not auto-video-ingest configured SD card. Exiting and ignoring it." debug
	exit 0
fi

# Reading the SD card configuration. It is parsed instead of sourced, so a card
# can only set these four keys and can not execute any code.
# Accepted formats: KEY="value", KEY='value' or KEY=value, optionally followed by a # comment.
NAME="" ; SRCDIRS="" ; EXCLUDES="" ; SUBFOLDER=""
CFG_RE="^[[:space:]]*(NAME|SRCDIRS|EXCLUDES|SUBFOLDER)=(\"([^\"]*)\"|'([^']*)'|([^[:space:]#]*))"
while IFS= read -r LINE || [ -n "$LINE" ]; do
	LINE=${LINE%$'\r'}	# tolerate windows line endings
	if [[ "$LINE" =~ $CFG_RE ]]; then
		printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[3]}${BASH_REMATCH[4]}${BASH_REMATCH[5]}"
	fi
done <"$CARDCFG"

# Checking if SD card configuration is valid
if [ -z "$NAME" ];
then
	log "auto-video-ingest cfg NAME not set. Exiting..." critical
	exit 0
fi
if [ -z "$SRCDIRS" ];
then
	log "auto-video-ingest cfg SRCDIRS not set. Exiting..." critical
	exit 0
fi
if [ -z "$EXCLUDES" ];
then
	log "auto-video-ingest cfg EXCLUDES not set." debug
fi
if [ -z "$SUBFOLDER" ];
then
	log "auto-video-ingest cfg SUBFOLDER not set. Exiting..." critical
	exit 0
fi

# ensure mounted NAS: TARGET (or the folder it is in) must be on a mount other than /
TARGET_MOUNT=$(findmnt --noheadings --output TARGET --target "$TARGET" 2>/dev/null)
if [ ! -d "$TARGET" ] || [ -z "$TARGET_MOUNT" ] || [ "$TARGET_MOUNT" = "/" ];
then
	log "NAS not mounted on $TARGET. Exiting" critical
	exit 1
fi

# creating definitive target directory variable
TARGETDIR="$TARGET/Media/$SUBFOLDER/$(date +%Y)/$(date +%Y-%m-%d)/$NAME"

# creating target dir
mkdir -p "$TARGETDIR"
if [ ! -d "$TARGETDIR" ];
then
	log "Unable to create target directory. Exiting" critical
	exit 1
fi

# doing the actual move and cleanup
log "Moving files to $TARGETDIR"

# read -a splits on whitespace without glob expansion, so "*.BIN" stays a pattern
read -ra SRCDIR_LIST <<<"$SRCDIRS"
read -ra EXCLUDE_LIST <<<"$EXCLUDES"
EXCLUDE_ARGS=()
for EXCLUDE in "${EXCLUDE_LIST[@]}"; do
	EXCLUDE_ARGS+=(--exclude="$EXCLUDE")
done

MOVE_START=$(date +%s)
FAILED_DIRS=()
for LOOPSRCDIR in "${SRCDIR_LIST[@]}"; do
	# -t keeps the original modification time (recording date) of the files
	if ! rsync -rt --backup --suffix="_$(date +%H-%M-%S)" --remove-source-files --log-file="$LOGFILE" "${EXCLUDE_ARGS[@]}" "$MOUNTPOINT/$LOOPSRCDIR/" "$TARGETDIR"; then
		FAILED_DIRS+=("$LOOPSRCDIR")
	fi
done
MOVE_DURATION=$(( $(date +%s) - MOVE_START ))

sync
if umount "$MOUNTPOINT"; then
	UNMOUNT_MSG="SD card unmounted, safe to remove."
	UNMOUNT_OK=1
else
	UNMOUNT_MSG="Could not unmount SD card $MOUNTPOINT!"
	UNMOUNT_OK=0
fi

if [ ${#FAILED_DIRS[@]} -gt 0 ]; then
	log "Moving FAILED for ${FAILED_DIRS[*]} after $MOVE_DURATION seconds. Remaining files are still on the card. $UNMOUNT_MSG" critical
	exit 1
elif [ "$UNMOUNT_OK" -eq 0 ]; then
	log "File moving finished after $MOVE_DURATION seconds. $UNMOUNT_MSG" critical
	exit 1
else
	log "File moving finished after $MOVE_DURATION seconds. $UNMOUNT_MSG"
fi
